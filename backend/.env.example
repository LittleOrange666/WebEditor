# 複製為 backend/.env，docker compose 會讀取（spec_new §7.1）

# 資料庫：預設 SQLite（存在 volume）；改用 PostgreSQL 時見 docker-compose.yml 的 postgres profile
# DATABASE_URL=postgresql+psycopg://webeditor:webeditor@db:5432/webeditor

# 允許的前端來源，逗號分隔（必須與瀏覽器網址列的 origin 完全相同，不含路徑）
ALLOWED_ORIGINS=https://editor.example.com,http://localhost:5173

# 自行註冊的初始值（之後以管理頁設定為準）
ALLOW_REGISTRATION=false

# 首次啟動時，若沒有任何管理員，自動建立此帳號（初始管理員，不可刪除）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please

# 部署在反向代理後面時設為 true，速率限制才會使用 X-Forwarded-For 中的真實 IP
TRUST_PROXY=false
