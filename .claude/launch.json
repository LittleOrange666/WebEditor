{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "subpath",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "scripts/serve-subpath.mjs",
        "4173",
        "/some/path/"
      ],
      "port": 4173
    },
    {
      "name": "api",
      "runtimeExecutable": "backend/.venv/Scripts/python.exe",
      "runtimeArgs": [
        "backend/dev.py"
      ],
      "port": 8000
    },
    {
      "name": "dev-cloud",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:cloud",
        "--",
        "--port",
        "5174",
        "--strictPort"
      ],
      "port": 5174
    }
  ]
}
